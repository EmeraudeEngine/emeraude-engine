 namespace fs = std::filesystem;
 namespace fg = fastgltf;
 
+namespace fastgltf::detail {
+	/**
+	 * Strict UTF-8 check (RFC 3629): no overlong form, no encoded surrogate, nothing past U+10FFFF.
+	 * A percent-decoded URI may hold any byte, and the path conversion below throws std::system_error on
+	 * invalid UTF-8 with MSVC (std::terminate in a build without exceptions).
+	 */
+	bool isValidUtf8(std::string_view text) noexcept {
+		std::size_t i = 0;
+		while (i < text.size()) {
+			const auto lead = static_cast<unsigned char>(text[i]);
+			std::size_t length = 0;
+			unsigned char low = 0x80, high = 0xBF;
+			if (lead <= 0x7F) {
+				++i;
+				continue;
+			} else if (lead >= 0xC2 && lead <= 0xDF) {
+				length = 2;
+			} else if (lead >= 0xE0 && lead <= 0xEF) {
+				length = 3;
+				low = lead == 0xE0 ? 0xA0 : 0x80;
+				high = lead == 0xED ? 0x9F : 0xBF;
+			} else if (lead >= 0xF0 && lead <= 0xF4) {
+				length = 4;
+				low = lead == 0xF0 ? 0x90 : 0x80;
+				high = lead == 0xF4 ? 0x8F : 0xBF;
+			} else {
+				return false;
+			}
+			if (text.size() - i < length)
+				return false;
+			const auto second = static_cast<unsigned char>(text[i + 1]);
+			if (second < low || second > high)
+				return false;
+			for (std::size_t k = 2; k < length; ++k) {
+				const auto next = static_cast<unsigned char>(text[i + k]);
+				if (next < 0x80 || next > 0xBF)
+					return false;
+			}
+			i += length;
+		}
+		return true;
+	}
+} // namespace fastgltf::detail
